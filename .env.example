# Copy to .env and adjust. Nothing here is required for local development.

# Port for the game server (the Vite dev server proxies to it).
PORT=3001

# Signs the session cookie. Set a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left empty, a random secret is used and sessions reset on every restart.
COOKIE_SECRET=

# Set to false to switch off the AI franchises (the end-to-end tests do).
AI_ENABLED=true

# Only needed if the client is served from a different origin than the server.
CLIENT_ORIGIN=
