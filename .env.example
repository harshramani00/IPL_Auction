# Copy to .env and adjust. Nothing here is required for local development.

# Game server port in development (the Vite dev server on 5173 proxies to it).
SERVER_PORT=3001
# Port in production (npm start). Hosting platforms usually set this for you.
PORT=3001

# Signs the session cookie. Set a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left empty, a random secret is used and sessions reset on every restart.
COOKIE_SECRET=

# Set to false to switch off the AI franchises (the end-to-end tests do).
AI_ENABLED=true

# Each set's players come up in a random order, different every game. Set to
# false for the official auction order (the end-to-end tests do).
SHUFFLE_SETS=true

# Only needed if the client is served from a different origin than the server.
CLIENT_ORIGIN=

# Only for `npm run voice`, which records the auctioneer's lines once (see the
# README). The game itself never uses these.
ELEVENLABS_API_KEY=
# A stock voice from ElevenLabs' library. Default: "George", a mature British man.
ELEVENLABS_VOICE_ID=
